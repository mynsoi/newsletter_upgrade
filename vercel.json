{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip-install",
  "buildCommand": "echo skip-build",
  "outputDirectory": "site",
  "ignoreCommand": "p=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e \"$p^{commit}\" 2>/dev/null || git fetch -q --depth=1 origin \"$p\" 2>/dev/null; git cat-file -e \"$p^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$p\" HEAD -- site/ api/ vercel.json requirements.txt",
  "functions": {
    "api/reader.py": {
      "excludeFiles": "{app,briefs,columns,config,design,docs,pipeline,publish,runs,scripts,site,sources,tests,tools,trash,web,wiki,wiki-eval}/**"
    },
    "api/chat.py": {
      "excludeFiles": "{app,briefs,columns,config,design,docs,pipeline,publish,runs,scripts,site,sources,tests,tools,trash,web,wiki,wiki-eval}/**",
      "maxDuration": 60
    }
  },
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
