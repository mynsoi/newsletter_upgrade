    ".cmp-di-social-share",
    ".cmp-di-right-rail",
    ".cmp-di-link-list",
    ".cmp-di-breadcrumb",
    "nav",
    "aside",
    "footer",
    "figcaption",
    "form"
   ],
   "link_text": "ARTICLE|REPORT"
  },
  "bcg-publications": {
   "mode": "list",
   "tier": "T2",
   "lang": "en",
   "list_urls": [
    "https://www.bcg.com/publications"
   ],
   "link": "^https://www\\.bcg\\.com/publications/20\\d\\d/[a-z0-9-]+$",
   "container": "main",
   "exclude": [
    "[class*='StickyToolbarWidget']",
    "[class*='Subscribe']",
    "[class*='related']",
    "[class*='Related']",
    "[class*='share']",
    "[class*='author']",
    "nav",
    "aside",
    "footer",
    "figcaption",
    "form"
   ]
  },
  "pwc-global-insights": {
   "mode": "off",
   "tier": "T2",
   "lang": "en",
   "list_urls": [
    "https://www.pwc.com/gx/en/research-insights.html"
   ],
   "link": "^https://www\\.pwc\\.com/gx/en/issues/[a-z0-9-]+/[a-z0-9-]+\\.html$",
   "container": ".text-component",
   "exclude": [
    "nav",
    "footer",
    "aside",
    "form",
    "[class*='cookie']",
    "[class*='vjs-']"
   ],
   "max_per_run": 5,
   "note": "2026-10-20 시험 — 목록의 issues 페이지가 허브라 본문 108~677자(짧음). main 판단(2026-09-02 '연 단위 리포트, 목록 라운드 실효 없음')과 같아 자동에서 뺌. 연례 리포트는 --source pwc-global-insights --url <주소>로 건별"
  },
  "dbr": {
   "mode": "list",
   "tier": "T3",
   "lang": "ko",
   "paid": true,
   "login_marker": "로그아웃",
   "license_note": "구독 계정 세션 자동 수집(2026-10-20 규칙 6 개정) — 내부 분석 한정, 원문 외부 비공개",
   "list_urls": [
