added=0; changed=[]; status_changes=[]
for name,old in before['pages'].items():
 p=Path(name); rel=str(p.relative_to(root)); text=p.read_text()
 assert text==old, f'concurrent edit: {rel}'
 out=[]; ids=[]
 for line in text.splitlines():
  match=re.match(r'"'^'"\\| \\[((?:threads|linkedin)/\\d+)\\]',line)
  if match:
   sid=match[1]; ids.append(sid); kind='회사' if sid in company else '개인'
   cells=line.split('|'); author=cells[2].strip()
   if not re.search(r' · (회사|개인)"'$'"',author):
    author += ' · '+kind; added+=1
   else: assert author.endswith(' · '+kind),(sid,author,kind)
   cells[2]=' '+author+' '; line='|'.join(cells)
  out.append(line)
 text='\\n'.join(out)+'\\n'
 status=re.search(r'"'^status: (.*)$'"',text,re.M)[1]
 if not company.intersection(ids) and status not in ['씀','진행 중','회사 사례 없음']:
  text=text.replace('status: '+status,'status: 회사 사례 없음',1); status_changes.append(rel)
 if rel in changes:
  change=changes[rel]
  if change['description']:
   text=re.sub(r'"'^description: .*$'"',lambda _: 'description: '+change['description'],text,count=1,flags=re.M)
  if change['thesis']:
   text=re.sub(r'(?<=## 이 글이 말할 것\\n).*?(?=\\n\\n## 원문)',lambda _:change['thesis'],text,count=1,flags=re.S)
  if change['angles']:
   text=re.sub(r'(?<=## 쓸 수 있는 각도\\n).*?(?=\\n\\n## 함께 볼 주제)',lambda _:'\\n'.join('- '+a for a in change['angles']),text,count=1,flags=re.S)
 for a,b in replacements.get(rel,{}).items():
  assert a in text,rel; text=text.replace(a,b,1)
 if text"'!=old:
  text=re.sub(r'"'"'^timestamp: .*$'"', 'timestamp: 2026-10-10',text,flags=re.M,count=1)
  p.write_text(text); changed.append(rel)
index=Path('index.md'); text=index.read_text(); assert text==before['index']
def index_row(match):
 p=Path(match[2]); body=p.read_text(); fields=dict(re.findall(r'"'^(title|description|timestamp|status): (.*)$'"',body,re.M))
 count=len(re.findall(r'"'^'"\\| \\[(?:threads|linkedin)/\\d+\\]',body,re.M))
 return f\"| [{fields['title']}]({p}) | {fields['description']} | {count} | {fields['status']} | {fields['timestamp']} |\"
text=re.sub(r'"'^'"\\| \\[(["'^'"\\]]+)\\]\\((["'^)]+'"\\.md)\\).*"'$'"',index_row,text,flags=re.M)
index.write_text(text)
report={'company':sorted(company),'classifications_added':added,'changed':changed,'body_changes':sorted(set(changes)|set(replacements)),'status_changes':status_changes}
