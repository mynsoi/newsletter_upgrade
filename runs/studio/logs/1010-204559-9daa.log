from pathlib import Path
import re,json,hashlib
root=Path.cwd(); pages={str(p):p.read_text() for p in sorted(root.glob('*/*.md')) if p.read_text().startswith('---\\ntype: topic\\n')}
sources={str(p.resolve()):hashlib.sha256(p.read_bytes()).hexdigest() for p in Path('../sources/originals').glob('*/*') if p.is_file()}
Path('/tmp/wiki-lint-before-20261010.json').write_text(json.dumps({'pages':pages,'index':Path('index.md').read_text(),'log':Path('log.md').read_text(),'sources':sources},ensure_ascii=False))
rows=[]; used=set()
for name,txt in pages.items():
 r=re.findall(r'"'^'"\\| \\[(threads/\\d+|linkedin/\\d+)\\].*"'$'"',txt,re.M); used.update(r)
