+        text = text.replace('status: 회사 사례 없음\n', 'status: 쓸 수 있음\n')
+        restored.append(str(path.relative_to(ROOT)))
+    prefix, rest = text.split('## 쓸 수 있는 각도\n', 1)
+    section, suffix = rest.split('\n## 함께 볼 주제', 1)
+    old_angles = [line[2:] for line in section.splitlines() if line.startswith('- ')]
+    roles = ROLES[path.stem].split(',')
+    assert len(old_angles) == len(roles), path
+    new_angles = []
+    for n, (old_angle, role) in enumerate(zip(old_angles, roles), 1):
+        angle = ANGLES.get((path.stem, n), old_angle)
+        # 개인 원문이라는 이유만으로 보조에 한정하던 문장은 제거한다.
+        # 원문과 제안 장면의 구분, 성과·검증의 한계 설명은 그대로 둔다.
+        angle = re.sub(r' (?:개인의 |개인 |원문의 개인 |에이전시 원문은 )[^.]*보조[^.]*\.', '', angle)
+        angle = angle.replace('회사 원문', '원문').replace('회사 실험', '원문의 실험')
+        new_angles.append(f'- [{role}] {angle}')
+    angle_count += len(new_angles)
+    text = prefix + '## 쓸 수 있는 각도\n' + '\n'.join(new_angles) + '\n\n## 함께 볼 주제' + suffix
+    text = re.sub(r'^timestamp: .+$', f'timestamp: {TODAY}', text, flags=re.M)
+    if path.stem == '문체만으로-AI-글을-단정하지-말자':
+        text = text.replace('개인의 문체 실험이 보여 주듯 경험담과 감정이 담긴 말투도 AI에 주문할 수 있으므로,', '경험담과 감정이 담긴 말투도 AI에 주문할 수 있으므로,')
+    if text != before:
+        plans[path] = text
+        changes.append(str(path.relative_to(ROOT)))
+
+index_path = ROOT / 'index.md'
+index = index_path.read_text()
+index_rows = 0
+for path in files:
+    text = plans.get(path, path.read_text())
+    meta = yaml.safe_load(text.split('---', 2)[1])
+    sources = re.findall(r'\]\(../../sources/originals/[^)]+\)', text)
+    rel = str(path.relative_to(ROOT))
+    row = f"| [{meta['title']}]({rel}) | {meta['description']} | {len(sources)} | {meta['status']} | {meta['timestamp']} |"
+    pattern = r'^\| \[[^\n]+\]\(' + re.escape(rel) + r'\) \|[^\n]+$'
+    index, count = re.subn(pattern, lambda _: row, index, flags=re.M)
+    assert count == 1, (path, count)
+    index_rows += count
+if index != index_path.read_text():
+    plans[index_path] = index
+
+for path, content in plans.items():
+    path.write_text(content)
+
+report = {
+    'changed_topics': changes, 'removed_markers': removed_markers,
+    'restored_status': restored, 'tagged_angles': angle_count,
+    'company_scene_rewrites': len(ANGLES), 'index_rows': index_rows,
+}
+Path('/tmp/wiki-lint-20261010-edits.json').write_text(json.dumps(report, ensure_ascii=False, indent=2))
+print(json.dumps(report, ensure_ascii=False, indent=2))
