+changes = []
+removed_markers = 0
+restored = []
+angle_count = 0
+plans = {}
+files = sorted(ROOT.glob('*/*.md'))
+assert {p.stem for p in files} == set(ROLES)
+for path in files:
+    before = path.read_text()
+    text, count = re.subn(r' · (?:회사|개인)(?= \|)', '', before)
+    removed_markers += count
+    if 'status: 회사 사례 없음\n' in text:
+        text = text.replace('status: 회사 사례 없음\n', 'status: 쓸 수 있음\n')
+        restored.append(str(path.relative_to(ROOT)))
+    prefix, rest = text.split('## 쓸 수 있는 각도\n', 1)
+    section, suffix = rest.split('\n## 함께 볼 주제', 1)
+    old_angles = [line[2:] for line in section.splitlines() if line.startswith('- ')]
+    roles = ROLES[path.stem].split(',')
+    assert len(old_angles) == len(roles), path
+    new_angles = []
+    for n, (old_angle, role) in enumerate(zip(old_angles, roles), 1):
+        angle = ANGLES.get((path.stem, n), old_angle)
+        # 개인 원문이라는 이유만으로 보조에 한정하던 문장은 제거한다.
