exec
/bin/bash -lc "python - <<'PY'
from pathlib import Path
import re
name = '업무자동화/작은-반복부터-덜어내기.md'
p = Path(name)
data = p.read_text()
classes = {'threads/05':'회사','threads/06':'개인','linkedin/07':'개인','linkedin/10':'개인','threads/13':'개인','threads/14':'회사','linkedin/13':'개인','threads/22':'회사','threads/23':'회사'}
lines=data.splitlines()
for i,line in enumerate(lines):
    for ref,cls in classes.items():
        if line.startswith(f'| [{ref}]'):
            cells=line.split('|')
            cells[2]=cells[2].rstrip()+f' · {cls} '
            lines[i]='|'.join(cells)
data='\\n'.join(lines)+'\\n'
url=re.search(r'"'^url: (.+)$'"',Path('../sources/originals/linkedin/32.md').read_text(),re.M).group(1)
row=f'| [linkedin/32](../../sources/originals/linkedin/32.md) · {url} | 윤용승 · 9월 29일 · 개인 | 개인 서버의 AI 비서가 메일에서 답장이 필요한 건을 골라 초안을 메신저로 전달했다고 전한다. 회사 메일에서도 분류와 초안 준비처럼 범위를 좁혀 맡길 일을 찾는 보조 사례로 쓴다. 개인 서버 설치와 연속 가동 기록을 사내 도입 사례로 보지는 않는다. |'
assert '[linkedin/32]' not in data
