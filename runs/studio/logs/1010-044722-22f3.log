from pathlib import Path
import re

def metadata(text):
    assert text.startswith('---\\n')
    header = text.split('---', 2)[1]
    return dict((k, v.strip().strip(\"'\\\"\")) for k, v in re.findall(r'"'^([a-z_]+):[ '"\\t]*(.*)"'$'"', header, re.M))

pages = {p.as_posix(): p for p in Path('.').glob('*/*.md')}
index = Path('index.md').read_text()
rows = [line for line in index.splitlines() if line.startswith('| [')]
assert len(rows) == len(pages), (len(rows), len(pages))
required = {'type', 'title', 'description', 'tags', 'timestamp', 'status', 'used_in'}
seen = set()
source_rows = 0
new_sources = {f'linkedin/{n}': [] for n in range(22,28)}
for row in rows:
    cols = [c.strip() for c in row.strip('|').split('|')]
    title, name = re.fullmatch(r'\\[(.+)\\]\\((.+)\\)', cols[0]).groups()
    assert name not in seen
    seen.add(name)
    p = pages[name]
    text = p.read_text()
    meta = metadata(text)
    assert required <= set(meta), name
    assert meta['type'] == 'topic' and meta['status'] in {'쓸 수 있음', '씀', '진행 중'}, name
    assert (title, cols[1], cols[3], cols[4]) == (meta['title'], meta['description'], meta['status'], meta['timestamp']), name
    for section in ('이 글이 말할 것', '원문', '쓸 수 있는 각도', '함께 볼 주제'):
        assert f'## {section}\\n' in text, (name, section)
    table = text.split('## 원문\\n', 1)[1].split('## 쓸 수 있는 각도', 1)[0].strip()
    assert all(line.startswith('|') for line in table.splitlines()), (name, '원문 표 중단')
    sources = [line for line in table.splitlines() if line.startswith('| [')]
    assert len(sources) == int(cols[2]), name
    assert len(sources) == len(set(re.findall(r'\\]\\((["'^)]+)'"\\)', '\\n'.join(sources)))), (name, '중복 원문')
    source_rows += len(sources)
    for source_row in sources:
        cells = [c.strip() for c in source_row.strip('|').split('|')]
        assert len(cells) == 3, name
        assert 'https://' in cells[0] and ' · ' in cells[1] and cells[2], name
        key, rel = re.search(r'\\[(["'^]]+)'"\\]\\((["'^)]+)'"\\)', cells[0]).groups()
        if key in new_sources:
            original = metadata((p.parent / rel).read_text())
            assert original['url'] in cells[0], (name, key, 'URL')
            assert cells[1].startswith(original['author'] + ' · '), (name, key, '작성자')
            if original['date']:
                assert cells[1].split(' · ', 1)[1] == original['date'], (name, key, '날짜')
            else:
                assert '날짜 미상' in cells[1], (name, key, '미상 날짜')
            assert meta['timestamp'] == '2026-10-10', name
            new_sources[key].append(name)
assert set(pages) == seen
for p in [Path('index.md'), Path('log.md'), *pages.values()]:
    for target in re.findall(r'\\[["'^'"\\]]*\\]\\((["'^)]+)'"\\)', p.read_text()):
        if not target.startswith(('http://', 'https://', '#', 'mailto:')):
            assert (p.parent / target.split('#')[0]).exists(), (str(p), target)
log = Path('log.md').read_text()
entries = re.findall(r'"'^- ingest ../sources/originals/linkedin/(2[2-7])'"\\.md \\| (.+?) \\| (.+)"'$'"', log, re.M)
assert [int(n) for n,_,_ in entries] == [27,26,25,24,23,22], entries
for n, action, paths in entries:
    assert action == ('새 주제' if n == '22' else '합침')
    assert set(paths.split(', ')) == set(new_sources[f'linkedin/{n}'])
assert all(new_sources.values())
assert not Path('업무방식/AI-구독을-늘리기-전에-쓸모를-확인하자.md').exists()
print(f'확인 완료: 주제 {len(pages)}개와 목차 일치, 원문 표 {source_rows}행, 상대경로 링크 이상 없음')
print('신규 원문 6개: URL·작성자·날짜·2026-10-10 갱신일·최신순 ingest 기록 일치')
for key, paths in new_sources.items():
    print(key + ' → ' + ', '.join(paths))
