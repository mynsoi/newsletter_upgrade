{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "publish-ui",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "web/server.py"
      ],
      "port": 5001
    },
    {
      "name": "site-preview",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5055",
        "--bind",
        "127.0.0.1",
        "--directory",
        "output"
      ],
      "port": 5055
    }
  ]
}
